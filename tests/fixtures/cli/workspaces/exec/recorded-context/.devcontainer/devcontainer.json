{
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "decune",
  "userEnvProbe": "loginShell",
  "containerEnv": {
    "DECUNE_EXEC_SECRET": "${localEnv:DECUNE_TEST_EXEC_SECRET}"
  },
  "remoteEnv": {
    "DECUNE_HOME_BIN": "${remoteUserHome}/bin",
    "DECUNE_LOCAL": "${localEnv:DECUNE_TEST_EXEC_LOCAL}",
    "DECUNE_REMOTE_SECRET": "${containerEnv:DECUNE_EXEC_SECRET}",
    "DECUNE_SHARED": "from-remote-env"
  }
}
